{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "anotacoes.pulsoenfermagem.com.br"
        }
      ],
      "dest": "/anotacoes/index.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.pulsoenfermagem.com.br"
        }
      ],
      "dest": "/pulso-anota.html"
    }
  ]
}
